      "link": null,
      "locked": false,
      "text": "1.online status\n2. kv store\n3. heartbeat\n4. small data per record\n\n{\nuser_id,\n{timestamp:\nstatus:\nchat_server}\n}\n\n1B * 20% = 200M active user\n200M  * 25% online = 50 M\n50M * 100B =  5GB RAM\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.online status\n2. kv store\n3. heartbeat\n4. small data per record\n\n{\nuser_id,\n{timestamp:\nstatus:\nchat_server}\n}\n\n1B * 20% = 200M active user\n200M  * 25% online = 50 M\n50M * 100B =  5GB RAM\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
