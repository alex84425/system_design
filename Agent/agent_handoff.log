```python
import heapq


def dijkstra(graph: dict[str, dict[str, int]], start: str) -> dict[str, int | float]:
    if not graph:
        return {}

    if start not in graph:
        raise KeyError(f"Start node '{start}' not in graph")

    for u, neighbors in graph.items():
        for v, w in neighbors.items():
            if w < 0:
                raise ValueError(
                    f"Negative weight edge {u}→{v} (weight={w}) is not supported by Dijkstra"
                )

    dist: dict[str, int | float] = {node: float("inf") for node in graph}
    dist[start] = 0

    heap = [(0, start)]

    while heap:
        cost, u = heapq.heappop(heap)
        if cost > dist[u]:
            continue
        for v, w in graph[u].items():
            new_cost = dist[u] + w
            if new_cost < dist[v]:
                dist[v] = new_cost
                heapq.heappush(heap, (new_cost, v))

    return dist


if __name__ == "__main__":
    # 1. Empty graph
    assert dijkstra({}, "A") == {}

    # 2. Start not in graph → KeyError
    try:
        dijkstra({"A": {"B": 1}}, "Z")
        assert False
    except KeyError:
        pass

    # 3. Negative weight → ValueError
    try:
        dijkstra({"A": {"B": -1}}, "A")
        assert False
    except ValueError:
        pass

    # 4. Single node
    assert dijkstra({"A": {}}, "A") == {"A": 0}

    # 5. Isolated / unreachable node
    g = {"A": {"B": 1}, "B": {}, "C": {}}
    r = dijkstra(g, "A")
    assert r == {"A": 0, "B": 1, "C": float("inf")}

    # 6. Self-loop — distance stays 0
    g = {"A": {"A": 5, "B": 2}, "B": {}}
    r = dijkstra(g, "A")
    assert r["A"] == 0 and r["B"] == 2

    # 7. Sparse graph
    g = {
        "A": {"B": 4, "C": 2},
        "B": {"D": 3, "C": 1},
        "C": {"B": 1, "D": 5},
        "D": {},
    }
    assert dijkstra(g, "A") == {"A": 0, "B": 3, "C": 2, "D": 6}

    # 8. Dense graph
    g = {
        "A": {"B": 1, "C": 4, "D": 7},
        "B": {"C": 2, "D": 5},
        "C": {"D": 1},
        "D": {},
    }
    assert dijkstra(g, "A") == {"A": 0, "B": 1, "C": 3, "D": 4}

    # 9. Disconnected graph
    g = {"A": {"B": 1}, "B": {}, "C": {"D": 2}, "D": {}}
    r = dijkstra(g, "A")
    assert r["A"] == 0 and r["B"] == 1
    assert r["C"] == float("inf") and r["D"] == float("inf")

    print("All tests passed ✓")
```

